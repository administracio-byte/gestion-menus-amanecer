export type Floor = '0' | '1' | '2' | '3';

export type DietType = 
  | 'Normal' 
  | 'Normal Disfágia' 
  | 'Mixto (ND+TX)' 
  | 'Normal Disfágia Diabético' 
  | 'Normal Diabético' 
  | 'Triturado';

export type MealType = 'breakfast' | 'lunch' | 'snack' | 'dinner';

export interface DailyRecord {
  date: string; // ISO string YYYY-MM-DD
  counts: {
    [floor in Floor]: {
      [diet in DietType]: {
        breakfast: number;
        lunch: number;
        snack: number;
        dinner: number;
      }
    }
  };
  familyCounts: {
    [floor in Floor]: number;
  };
}

export interface Resident {
  id: string;
  name: string;
  surname: string;
  floor: Floor;
  mealFloors?: {
    breakfast: Floor;
    lunch: Floor;
    snack: Floor;
    dinner: Floor;
  };
  diet: DietType;
  lactoseFree?: boolean;
  notes?: string;
  isAbsent: boolean; // Ausencia total
  mealAbsences?: { // Ausencias granulares
    breakfast: boolean;
    lunch: boolean;
    snack: boolean;
    dinner: boolean;
  };
  isDayCenter: boolean;
  dayCenterSchedule?: {
    breakfast: boolean;
    lunch: boolean;
    snack: boolean;
    dinner: boolean;
  };
}

