import React, { useState, useEffect, useRef } from 'react';
import { DailyCountView } from './components/DailyCountView';
import { ResidentManager } from './components/ResidentManager';
import { AbsenceManager } from './components/AbsenceManager';
import { MonthlyBillingView } from './components/MonthlyBillingView';
import { INITIAL_RESIDENTS } from './constants';
import { Resident, DailyRecord } from './types';
import { LayoutDashboard, Users, UserX, FileText, Save, FolderOpen, RefreshCw } from 'lucide-react';

const App: React.FC = () => {
  const [activeTab, setActiveTab] = useState<'count' | 'residents' | 'absences' | 'billing'>('count');
  const fileInputRef = useRef<HTMLInputElement>(null);
  
  const [residents, setResidents] = useState<Resident[]>(() => {
    const saved = localStorage.getItem('amanecer_residents');
    return saved ? JSON.parse(saved) : INITIAL_RESIDENTS;
  });
  
  const [history, setHistory] = useState<DailyRecord[]>(() => {
    const saved = localStorage.getItem('amanecer_history');
    return saved ? JSON.parse(saved) : [];
  });
  
  const [familyCounts, setFamilyCounts] = useState<Record<string, number>>({});
  const [selectedDate, setSelectedDate] = useState(new Date());

  useEffect(() => {
    localStorage.setItem('amanecer_residents', JSON.stringify(residents));
  }, [residents]);

  useEffect(() => {
    localStorage.setItem('amanecer_history', JSON.stringify(history));
  }, [history]);

  const handleSaveDay = (record: DailyRecord) => {
    setHistory(prev => {
      const filtered = prev.filter(r => r.date !== record.date);
      return [...filtered, record];
    });
    alert(`Día ${record.date} guardado correctamente en el historial.`);
  };

  // Función para exportar la base de datos a un archivo local con nombre dinámico basado en la fecha seleccionada
  const exportDatabase = () => {
    const data = {
      residents,
      history,
      exportDate: new Date().toISOString()
    };

    // Formatear la fecha seleccionada para el nombre del archivo (DD-MM-YYYY)
    const day = String(selectedDate.getDate()).padStart(2, '0');
    const month = String(selectedDate.getMonth() + 1).padStart(2, '0');
    const year = selectedDate.getFullYear();
    const formattedDate = `${day}-${month}-${year}`;
    
    // Nombre de archivo según requerimiento: DD-MM-YYYY_menús_amanecer
    const filename = `${formattedDate}_menús_amanecer.json`;

    const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = filename;
    link.click();
    URL.revokeObjectURL(url);
  };

  // Función para importar la base de datos desde un archivo local
  const importDatabase = (event: React.ChangeEvent<HTMLInputElement>) => {
    const file = event.target.files?.[0];
    if (!file) return;

    const reader = new FileReader();
    reader.onload = (e) => {
      try {
        const json = JSON.parse(e.target?.result as string);
        if (json.residents && json.history) {
          if (confirm('¿Deseas cargar estos datos? Se sustituirá la información actual de este navegador.')) {
            setResidents(json.residents);
            setHistory(json.history);
            alert('Datos sincronizados correctamente.');
          }
        } else {
          alert('El archivo no tiene el formato correcto.');
        }
      } catch (err) {
        alert('Error al leer el archivo.');
      }
    };
    reader.readAsText(file);
    if (fileInputRef.current) fileInputRef.current.value = '';
  };

  return (
    <div className="min-h-screen flex flex-col bg-gray-50">
      <nav className="bg-white border-b border-gray-200 sticky top-0 z-10 no-print shadow-sm">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div className="flex justify-between h-16">
            <div className="flex">
              <div className="flex-shrink-0 flex items-center gap-2">
                <div className="bg-yellow-400 p-1.5 rounded-lg">
                    <span className="font-bold text-sky-900 text-lg">RA</span>
                </div>
                <span className="font-bold text-xl text-gray-800 hidden md:block">Gestión Amanecer</span>
              </div>
              <div className="hidden sm:ml-6 sm:flex sm:space-x-8">
                <button 
                  onClick={() => setActiveTab('count')} 
                  className={`${activeTab === 'count' ? 'border-sky-500 text-gray-900' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300'} inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium transition-colors`}
                >
                  <LayoutDashboard size={18} className="mr-2" /> Conteo Diario
                </button>
                <button 
                  onClick={() => setActiveTab('residents')} 
                  className={`${activeTab === 'residents' ? 'border-sky-500 text-gray-900' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300'} inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium transition-colors`}
                >
                  <Users size={18} className="mr-2" /> Residentes
                </button>
                <button 
                  onClick={() => setActiveTab('absences')} 
                  className={`${activeTab === 'absences' ? 'border-sky-500 text-gray-900' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300'} inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium transition-colors`}
                >
                  <UserX size={18} className="mr-2" /> Asistencia
                </button>
                <button 
                  onClick={() => setActiveTab('billing')} 
                  className={`${activeTab === 'billing' ? 'border-sky-500 text-gray-900' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300'} inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium transition-colors`}
                >
                  <FileText size={18} className="mr-2" /> Facturación
                </button>
              </div>
            </div>

            {/* Botones de Sincronización Local */}
            <div className="flex items-center gap-2">
              <input type="file" ref={fileInputRef} className="hidden" accept=".json" onChange={importDatabase} />
              <button 
                onClick={() => fileInputRef.current?.click()}
                title="Cargar base de datos desde archivo"
                className="p-2 text-gray-500 hover:text-sky-600 hover:bg-sky-50 rounded-full transition-all flex items-center gap-1 text-xs font-bold"
              >
                <FolderOpen size={20} />
                <span className="hidden lg:block uppercase tracking-wider">Cargar</span>
              </button>
              <button 
                onClick={exportDatabase}
                title={`Guardar base de datos (${selectedDate.toLocaleDateString('es-ES')})`}
                className="p-2 text-gray-500 hover:text-green-600 hover:bg-green-50 rounded-full transition-all flex items-center gap-1 text-xs font-bold"
              >
                <Save size={20} />
                <span className="hidden lg:block uppercase tracking-wider">Guardar</span>
              </button>
            </div>
          </div>
        </div>
      </nav>

      <main className="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
        {activeTab === 'count' && (
          <DailyCountView 
            residents={residents} 
            date={selectedDate}
            setDate={setSelectedDate}
            familyCounts={familyCounts}
            setFamilyCounts={setFamilyCounts}
            onSaveDay={handleSaveDay}
          />
        )}
        {activeTab === 'residents' && (
          <ResidentManager 
            residents={residents} 
            setResidents={setResidents} 
          />
        )}
        {activeTab === 'absences' && (
          <AbsenceManager 
            residents={residents} 
            setResidents={setResidents}
            date={selectedDate}
          />
        )}
        {activeTab === 'billing' && (
          <MonthlyBillingView 
            history={history} 
          />
        )}
      </main>
      
      <footer className="bg-white border-t border-gray-200 py-6 no-print">
         <div className="flex flex-col items-center gap-2">
            <div className="text-center text-sm text-gray-500">
               &copy; {new Date().getFullYear()} - Residencia Amanecer
            </div>
            <div className="flex items-center gap-2 text-[10px] text-gray-400 bg-gray-50 px-3 py-1 rounded-full border border-gray-100">
               <RefreshCw size={10} className="animate-spin-slow" />
               <span>Almacenamiento local activo. Guarde el archivo para usar en otros navegadores.</span>
            </div>
         </div>
      </footer>
    </div>
  );
};

export default App;

